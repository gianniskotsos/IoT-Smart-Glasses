(function () {
  function getStorageKeys() {
    const uID = '{{user.userID}}';
    const cID = '{{user.caregiverID}}';
    return {
      historyKey: `notifications_history_${uID}_${cID}`,
      unreadKey: `notifications_unread_${uID}_${cID}`
    };
  }

  window.addNotification = function(item) {
    const { historyKey, unreadKey } = getStorageKeys();
    let history = JSON.parse(localStorage.getItem(historyKey) || '[]');

    if (history.find(n => n.id === item.id)) return;

    history.push(item);
    if (history.length > 100) history.shift();
    localStorage.setItem(historyKey, JSON.stringify(history));

    const unread = parseInt(localStorage.getItem(unreadKey) || '0', 10) || 0;
    localStorage.setItem(unreadKey, String(unread + 1));

    if (typeof window.updateBadge === 'function') {
      window.updateBadge();
    }
    if (typeof window.updateNotificationsUI === 'function') {
      window.updateNotificationsUI();
    }
  };

  
  window.getStorageKeys = getStorageKeys;
})();
  
  (function () {
    function updateHeaderBadge() {
      try {
        const badge = document.getElementById('notifications-badge');
        if (!badge) return;
        const unreadKey = `notifications_unread_{{user.userID}}_{{user.caregiverID}}`;
        const unread = parseInt(localStorage.getItem(unreadKey) || '0', 10) || 0;

        if (unread > 0) {
          badge.textContent = unread > 99 ? '99+' : unread;
          badge.style.display = 'inline-block';
        } else {
          badge.style.display = 'none';
        }
      } catch (e) {
        console.error("Badge update error:", e);
      }
    }

    
    window.updateBadge = updateHeaderBadge;

    
    document.addEventListener('DOMContentLoaded', updateHeaderBadge);
    window.addEventListener('storage', updateHeaderBadge);
  })();
