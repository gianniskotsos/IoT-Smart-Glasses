{{#if user.userID}}
    <script>
    let statusTimeout;
    const STATUS_THRESHOLD = 120000; 
    const lastSeenKey = `last_seen_{{user.userID}}`;
    function setOnline() {
        const indicator = document.getElementById('user-status-indicator');
        const statusText = document.getElementById('status-text');

        if (indicator) {
            indicator.classList.remove('offline');
            statusText.textContent = 'Online';
            indicator.title = "The user is online";
        }
        localStorage.setItem(lastSeenKey, Date.now());
        
        clearTimeout(window.offlineTimer);
        window.offlineTimer = setTimeout(setOffline, STATUS_THRESHOLD);
    }

    function setOffline() {
        const indicator = document.getElementById('user-status-indicator');
        const statusText = document.getElementById('status-text');

        if (indicator) {
            indicator.classList.add('offline');
            statusText.textContent = 'Offline';
            const lastSeenTs = localStorage.getItem(lastSeenKey);
            const lastSeenDate = new Date(parseInt(lastSeenTs));
            const now = new Date();

            let formatOptions = { hour: '2-digit', minute: '2-digit' };
           
            if (lastSeenDate.toDateString() !== now.toDateString()) {
                formatOptions.day = '2-digit';
                formatOptions.month = 'short';
            }

            const lastTimeStr = lastSeenDate.toLocaleString([], formatOptions);
            if (lastSeenTs){
                indicator.title = `Last seen: ${lastTimeStr}`;
            } else {
                indicator.title = `No recent activity`;
            }

        }
    }
    function checkInitialStatus() {
        const lastSeen = localStorage.getItem(lastSeenKey);
        const now = Date.now();

        if (lastSeen && (now - lastSeen < STATUS_THRESHOLD)) {
            setOnline();
        } else {
            setOffline();
        }
    }

    window.updateBadge = function() {
        const unreadKey = `notifications_unread_{{user.userID}}_{{user.caregiverID}}`;
        const badge = document.getElementById('notifications-badge');
        const unreadCount = parseInt(localStorage.getItem(unreadKey) || '0', 10);

        if (badge) {
            if (unreadCount > 0) {
                badge.textContent = unreadCount > 99 ? '99+' : unreadCount;
                badge.style.display = 'flex'; 
            } else {
                badge.style.display = 'none';
            }
        }
    };

    window.updateCommBadge = function(newMessage = false) {
    const badgeKey = `communications_unread`;
    const badge = document.getElementById('communications-badge');

 
    if (newMessage) {
        let currentCount = parseInt(localStorage.getItem(badgeKey) || '0', 10);
        currentCount += 1;
        localStorage.setItem(badgeKey, currentCount);
    }

    const unreadCount = parseInt(localStorage.getItem(badgeKey) || '0', 10);

    if (badge) {
        if (unreadCount > 0) {
            badge.textContent = unreadCount > 99 ? '99+' : unreadCount;
            badge.style.display = 'flex';
        } else {
            badge.style.display = 'none';
        }
    }
};

